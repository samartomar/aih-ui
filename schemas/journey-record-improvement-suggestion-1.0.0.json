{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:workbench:journey-record:improvement-suggestion:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "required",
    "rulesVersion",
    "revision",
    "scope",
    "change",
    "triggers",
    "references",
    "facts",
    "unknowns",
    "recordedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^suggestion-[a-f0-9]{32}$"
    },
    "schema": {
      "const": "urn:aihq:workbench:journey-record:improvement-suggestion:1.0.0"
    },
    "required": {
      "const": false
    },
    "rulesVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "itemId",
        "releaseSha256",
        "itemSha256",
        "content"
      ],
      "properties": {
        "kind": {
          "const": "add-item"
        },
        "itemId": {
          "type": "string",
          "pattern": "^[\\w.-]{1,180}$"
        },
        "releaseSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "itemSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recipeSha256",
            "materials"
          ],
          "properties": {
            "recipeSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "materials": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ruleId",
          "key",
          "text"
        ],
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}:[\\w.@-]{1,180}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "references": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "setting",
              "saved-reason",
              "request",
              "catalog-item"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "facts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "overhead",
              "scope",
              "dependency"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
    }
  }
}
