{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:workbench:journey-record:local-binding:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "required",
    "workspace",
    "member",
    "checkout",
    "observed",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^binding-[a-f0-9]{32}$"
    },
    "schema": {
      "const": "urn:aihq:workbench:journey-record:local-binding:1.0.0"
    },
    "required": {
      "const": false
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^workspace-[a-f0-9]{32}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "identity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "identity": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?:/[\\w.+~-]+){2,}$"
        }
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?:[A-Za-z]:[\\\\/]|\\\\\\\\|/)"
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "remotes",
        "revision",
        "worktree",
        "workingState"
      ],
      "properties": {
        "repository": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?:/[\\w.+~-]+){2,}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "remotes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "identity"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[\\w./-]{1,200}$"
              },
              "identity": {
                "oneOf": [
                  {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?:/[\\w.+~-]+){2,}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "revision": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "gitDirSha256"
          ],
          "properties": {
            "kind": {
              "enum": [
                "main",
                "linked"
              ]
            },
            "gitDirSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "workingState": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clean",
            "sha256"
          ],
          "properties": {
            "clean": {
              "type": "boolean"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "reasons",
        "verifiedAt"
      ],
      "properties": {
        "result": {
          "enum": [
            "matched",
            "confirmed"
          ]
        },
        "reasons": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ambiguous-remote",
              "fork",
              "moved",
              "no-remote",
              "similar-name"
            ]
          }
        },
        "verifiedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
        }
      }
    },
    "replaces": {
      "type": "string",
      "pattern": "^binding-[a-f0-9]{32}$"
    }
  }
}
