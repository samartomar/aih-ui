{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:workbench:journey-record:maintenance-disposition:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "required",
    "category",
    "subject",
    "scope",
    "candidate",
    "disposition",
    "recordedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^disposition-[a-f0-9]{32}$"
    },
    "schema": {
      "const": "urn:aihq:workbench:journey-record:maintenance-disposition:1.0.0"
    },
    "required": {
      "const": false
    },
    "category": {
      "enum": [
        "content",
        "software",
        "client",
        "environment"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "releaseSha256",
        "itemId",
        "itemSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "selection"
          ]
        },
        "releaseSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "itemId": {
          "type": "string",
          "pattern": "^[\\w.-]{1,180}$"
        },
        "itemSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "releaseSha256",
        "itemId",
        "itemSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "content-revision"
          ]
        },
        "releaseSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "itemId": {
          "type": "string",
          "pattern": "^[\\w.-]{1,180}$"
        },
        "itemSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "disposition": {
      "enum": [
        "keep-current",
        "skip",
        "defer"
      ]
    },
    "recordedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "deferUntil": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "deferUntil"
        ]
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "defer"
          }
        }
      }
    }
  ]
}
