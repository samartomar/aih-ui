{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:workbench:journey-record:maintenance-check:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "required",
    "checkedAt",
    "categories"
  ],
  "properties": {
    "id": {
      "const": "maintenance-check"
    },
    "schema": {
      "const": "urn:aihq:workbench:journey-record:maintenance-check:1.0.0"
    },
    "required": {
      "const": false
    },
    "checkedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "state"
        ],
        "properties": {
          "category": {
            "enum": [
              "content",
              "software",
              "client",
              "environment"
            ]
          },
          "state": {
            "enum": [
              "checked",
              "unknown",
              "not-selected"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "reason"
              ]
            },
            "then": {
              "properties": {
                "state": {
                  "const": "unknown"
                }
              }
            }
          }
        ]
      }
    }
  }
}
