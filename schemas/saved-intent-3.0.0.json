{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:workbench:saved-intent:3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "origins",
    "roots",
    "exclusions",
    "pins",
    "provenance",
    "inputs",
    "reviews"
  ],
  "properties": {
    "schema": {
      "const": "urn:aihq:workbench:saved-intent:3.0.0"
    },
    "origins": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "kind": {
                "const": "direct"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "releaseSha256",
              "templateId",
              "templateSha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "kind": {
                "const": "template"
              },
              "releaseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "templateId": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "templateSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "organizationPolicySha256",
              "organizationSelectionId"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "kind": {
                "const": "organization"
              },
              "organizationPolicySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "organizationSelectionId": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              }
            }
          }
        ]
      }
    },
    "roots": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "releaseSha256",
          "itemId",
          "itemSha256",
          "scope",
          "configuration",
          "originIds"
        ],
        "properties": {
          "releaseSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "itemId": {
            "type": "string",
            "pattern": "^[\\w.-]{1,180}$"
          },
          "itemSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "configuration": {
            "type": "object"
          },
          "originIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[\\w.-]{1,180}$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "originId",
          "releaseSha256",
          "itemId",
          "scope"
        ],
        "properties": {
          "originId": {
            "type": "string",
            "pattern": "^[\\w.-]{1,180}$"
          },
          "releaseSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "itemId": {
            "type": "string",
            "pattern": "^[\\w.-]{1,180}$"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "pins": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "releaseSha256",
          "itemId",
          "itemSha256",
          "recipe",
          "materials"
        ],
        "properties": {
          "releaseSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "itemId": {
            "type": "string",
            "pattern": "^[\\w.-]{1,180}$"
          },
          "itemSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "recipe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "byteLength"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "schema": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "materials": {
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "byteLength",
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[\\w.-]{1,180}$"
                },
                "schema": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "byteLength": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "releaseSha256",
          "sources",
          "materialSource"
        ],
        "properties": {
          "releaseSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "materialSource": {
            "type": "object"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "locator",
              "resolvedIdentity",
              "releaseSha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "kind": {
                "const": "local"
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "pattern": "^[\\w.-]{1,180}$"
                  }
                }
              },
              "resolvedIdentity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256"
                ],
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "releaseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "locator",
              "resolvedIdentity",
              "releaseSha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "kind": {
                "const": "git"
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repository"
                ],
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              },
              "resolvedIdentity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "revision",
                  "sha256"
                ],
                "properties": {
                  "revision": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40,64}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "releaseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "locator",
              "resolvedIdentity",
              "releaseSha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "kind": {
                "const": "npm"
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "range": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                }
              },
              "resolvedIdentity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "integrity",
                  "sha256"
                ],
                "properties": {
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "integrity": {
                    "type": "string",
                    "pattern": "^sha(256|384|512)-[A-Za-z0-9+/]+={0,2}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "releaseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "locator",
              "resolvedIdentity",
              "releaseSha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "kind": {
                "const": "organization"
              },
              "locator": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authorityId",
                  "sourceId"
                ],
                "properties": {
                  "authorityId": {
                    "type": "string",
                    "pattern": "^[\\w.-]{1,180}$"
                  },
                  "sourceId": {
                    "type": "string",
                    "pattern": "^[\\w.-]{1,180}$"
                  }
                }
              },
              "resolvedIdentity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "revision",
                  "sha256"
                ],
                "properties": {
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "releaseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      }
    },
    "reviews": {
      "$ref": "urn:aihq:workbench:review-decisions:1.0.0"
    }
  }
}
