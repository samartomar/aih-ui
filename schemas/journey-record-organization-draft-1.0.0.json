{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:workbench:journey-record:organization-draft:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "required",
    "entries",
    "targets"
  ],
  "properties": {
    "id": {
      "const": "organization-draft"
    },
    "schema": {
      "const": "urn:aihq:workbench:journey-record:organization-draft:1.0.0"
    },
    "required": {
      "const": true
    },
    "policyId": {
      "type": "string",
      "pattern": "^[\\w.-]{1,180}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "path",
        "revision"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "name"
          ],
          "properties": {
            "owner": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,100}$"
            }
          }
        },
        "path": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.json$"
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "enum": [
                "branch",
                "tag",
                "commit"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9._/-]+$"
            }
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "commit"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "item",
          "scope",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^entry-[a-f0-9]{32}$"
          },
          "item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "releaseSha256",
              "itemId",
              "itemSha256"
            ],
            "properties": {
              "releaseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "itemId": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "itemSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "obligation": {
            "enum": [
              "required",
              "recommended",
              "permitted",
              "prohibited"
            ]
          },
          "clients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "repositories": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "inputs": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[\\w.-]{1,180}$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "fixed"
                  ],
                  "properties": {
                    "fixed": {}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "choices"
                  ],
                  "properties": {
                    "choices": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 256,
                      "uniqueItems": true
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "allowDeclared"
                  ],
                  "properties": {
                    "allowDeclared": {
                      "const": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^target-[a-f0-9]{32}$"
          },
          "scope": {
            "enum": [
              "project",
              "user"
            ]
          },
          "client": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
