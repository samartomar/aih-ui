{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aihq:workbench:review-decisions:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "records",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "urn:aihq:workbench:review-decisions:1.0.0"
    },
    "records": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "actor",
          "recordedAt",
          "disposition",
          "reason",
          "subject",
          "finding",
          "evidence",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.-]{1,180}$"
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "individual",
                  "organization"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "recordedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
          },
          "disposition": {
            "enum": [
              "false-alarm",
              "accepted-risk"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "releaseSha256",
              "itemId",
              "itemSha256",
              "recipeIdentity",
              "materials"
            ],
            "properties": {
              "releaseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "itemId": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "itemSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "recipeIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "materials": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "sha256",
                    "byteLength"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[\\w.-]{1,180}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "byteLength": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "finding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "detectorId",
              "ruleId",
              "findingId"
            ],
            "properties": {
              "detectorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "ruleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "findingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observationIdentity",
              "detectorIdentity",
              "rulesIdentity",
              "configurationIdentity",
              "profileIdentity",
              "scopeIdentity",
              "coverageIdentity"
            ],
            "properties": {
              "observationIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "detectorIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "rulesIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "configurationIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "profileIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "scopeIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "coverageIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "state": {
            "enum": [
              "current",
              "reconsider"
            ]
          },
          "supersedes": {
            "type": "string",
            "pattern": "^[\\w.-]{1,180}$"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "actor",
          "recordedAt",
          "disposition",
          "reason",
          "subject",
          "finding",
          "evidence",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w.-]{1,180}$"
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "individual",
                  "organization"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "recordedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$"
          },
          "disposition": {
            "enum": [
              "false-alarm",
              "accepted-risk"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "releaseSha256",
              "itemId",
              "itemSha256",
              "recipeIdentity",
              "materials"
            ],
            "properties": {
              "releaseSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "itemId": {
                "type": "string",
                "pattern": "^[\\w.-]{1,180}$"
              },
              "itemSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "recipeIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "materials": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "sha256",
                    "byteLength"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[\\w.-]{1,180}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "byteLength": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "finding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "detectorId",
              "ruleId",
              "findingId"
            ],
            "properties": {
              "detectorId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "ruleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "findingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observationIdentity",
              "detectorIdentity",
              "rulesIdentity",
              "configurationIdentity",
              "profileIdentity",
              "scopeIdentity",
              "coverageIdentity"
            ],
            "properties": {
              "observationIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "detectorIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "rulesIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "configurationIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "profileIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "scopeIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "coverageIdentity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "state": {
            "enum": [
              "current",
              "reconsider"
            ]
          },
          "supersedes": {
            "type": "string",
            "pattern": "^[\\w.-]{1,180}$"
          }
        }
      }
    }
  }
}
