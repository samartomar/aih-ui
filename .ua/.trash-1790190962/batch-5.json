   "name": "ai-tools.js",
   "filePath": "src/app/ai-tools.js",
   "summary": "Header AI tools control that lists the AI CLI targets @aihq/core publishes as supported, keeps the user's selection as a browser-local draft, and never implies installation or connection status.",
