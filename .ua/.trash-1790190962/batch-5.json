   "name": "theme.js",
   "filePath": "src/app/theme.js",
   "summary": "Observes theme changes on <html> and briefly suppresses CSS transitions so already-rendered elements repaint against the new theme variables instead of keeping stale colours.",
   "tags": [
    "utility",
    "theming",
    "css",
    "mutation-observer"
   ],
   "complexity": "moderate",
   "languageNotes": "Uses a MutationObserver plus a double requestAnimationFrame with a setTimeout fallback, so transitions are restored even in tabs that are not painting."
